{"name": "2d5rrr333/moonbridge", "version": "0.1.0", "readme": "README.md", "repository": "https://github.com/2d5rrr333/moonbridge", "license": "Apache-2.0", "keywords": ["wasm", "bridge", "frontend", "elm-architecture", "json"], "source": "src", "preferred_target": "wasm-gc", "description": "The 'wasm owns state, JS is a thin shell' architecture as a reusable kit: a generic Session with an init/dispatch JSON protocol (state + effects envelope), plus a dependency-free browser runtime. The MoonBit core is the only decision point; the DOM shell only renders and executes effects.", "checksum": "28ea4d6ab27d7ecf36ab2c5b1633b85da01c3fbcc709a2ac35773090f3fda1ce", "created_at": "2026-09-12T02:15:30.739335+00:00", "yanked": false, "yanked_reason": null}
