{"deps":{"gaato/zstd":"0.3.1","gaato/brotli":"0.4.1","gaato/deflate":"0.1.0","gaato/mttp_core":"0.1.0","gaato/codec_bytes":"0.1.1"},"name":"gaato/mttp","readme":"README.md","source":"src","yanked":false,"license":"Apache-2.0","version":"0.3.0","checksum":"88b6470ca60731ba54d91e75546c2c4e519243233bb1ab5f8cee2879bab035ef","keywords":["http","client","server","retry","sse","async"],"created_at":"2026-11-12T09:15:52.881061+00:00","repository":"https://github.com/gaato/mttp","description":"HTTP for MoonBit apps that outgrow the built-in client: the module an app starts with, holding a ready client (retries with a budget, deadlines, redirects, cookies, decompression) and a server, on moonbitlang/core/async for native, wasm and js. Typed endpoints and OpenAPI come from gaato/mttp_core, which libraries depend on instead.","yanked_reason":null,"preferred-target":"native","supported-targets":"native+wasm+js"}
