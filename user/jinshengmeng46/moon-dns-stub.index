{"name": "jinshengmeng46/moon-dns-stub", "version": "0.1.0", "readme": "README.md", "repository": "https://github.com/jinshengmeng46/moon-dns-stub", "license": "Apache-2.0", "keywords": ["dns", "network", "stub-resolver", "rfc1035", "codec", "native"], "preferred_target": "native", "source": "src", "description": "Native DNS wire format codec and async stub resolver. Supports A/AAAA/MX/SRV/TXT/CNAME/NS/PTR/SOA with name compression, UDP/TCP fallback, CNAME chain, and TTL cache.", "deps": {"moonbitlang/async": "0.20.3", "moonbitlang/x": "0.4.46"}, "checksum": "045b31a79f052f71d8d2bc908f7a20b467540fa8036cd7f0d732e874225ac59e", "created_at": "2026-08-22T16:06:35.315094+00:00"}
