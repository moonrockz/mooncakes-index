{"name": "moonbitstack/moonkoog", "version": "0.4.1", "readme": "README.md", "repository": "https://github.com/moonbitstack/moonkoog", "license": "Apache-2.0", "keywords": ["koog", "agent", "llm", "tool-calling", "moonbit"], "description": "moonkoog \u2014 a MoonBit port of JetBrains Koog (1.1.1): a type-safe agent-orchestration framework. The prompt/message model, LLM client contract, tool registry with a JSON-schema descriptor model, and the AIAgent tool-calling loop (Koog's singleRunStrategy), built to compose with the moon-heke full-stack suite.", "deps": {"moonbitlang/async": "0.20.3", "DC-Z-lab/moonllm": "0.1.0"}, "checksum": "e08c861296758e7a06c09e8b16614a6a6649df2ad1abf5d11800230c5b365c3a", "created_at": "2026-09-14T01:23:35.243332+00:00", "yanked": false, "yanked_reason": null}
