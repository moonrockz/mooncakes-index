{"name": "riantr/moonbit_image", "version": "0.1.0", "readme": "README.mbt.md", "repository": "https://github.com/riantr/moonbit-image", "license": "MIT", "keywords": ["image", "codec", "bmp", "qoi", "tga", "png", "gif", "jpeg"], "description": "Pure-MoonBit image decoder/encoder covering BMP/QOI/TGA/PNG/GIF/JPEG. Forked from the lws/moonbit_image sources that moonbit-labeler vendors locally, packaged as a standalone library for mooncakes.io.", "warn_list": "", "preferred_target": "native", "supported_targets": "+native", "checksum": "df4258301cb73622f910e44d9bfad7890de90d6d78303482f4c64ebe1288424d", "created_at": "2026-08-24T17:23:33.467312+00:00"}
