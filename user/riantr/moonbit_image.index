{"name": "riantr/moonbit_image", "version": "0.2.0", "readme": "README.mbt.md", "repository": "https://github.com/riantr/moonbit-image", "license": "MIT OR Apache-2.0", "keywords": ["image", "codec", "bmp", "qoi", "tga", "png", "gif", "jpeg"], "description": "Pure-MoonBit image decoder/encoder covering BMP / QOI / TGA / PNG / GIF / JPEG with zero external runtime dependencies. Decoders raise a structured `DecodeError` sub-error type so callers can branch on cause (UnsupportedFormat / TruncatedData / InvalidHeader / InvalidValue / EncodeNotImplemented).", "warn_list": "", "preferred_target": "native", "supported_targets": "+native", "checksum": "0b1230de7538759efcdae5013fd50c4a0d63420a446f69c0c3d4c9b8511a838a", "created_at": "2026-08-24T18:14:43.039015+00:00"}
