{"name": "wcj12314/moon-flow-guard", "version": "0.1.0", "readme": "README.md", "repository": "https://github.com/wcj12314/1231", "license": "Apache-2.0", "keywords": ["security", "audit", "gate", "flow", "dns", "tcp", "moonbit"], "preferred_target": "wasm", "description": "MoonFlowGuard: a MoonBit traffic-flow security audit and policy gate with PASS/REVIEW/FAIL verdicts, risk scoring and CI reports. Inputs are flow records (CSV) or decoded traffic; PCAP reading is a small built-in capability for tests, not the deliverable.", "deps": {"moonbitlang/x": "0.4.46"}, "checksum": "add300dab5bc2bc015b6e03891532f05a3af1955a0e2565bc4fafb96cb8ee52c", "created_at": "2026-08-23T13:36:31.488846+00:00"}
